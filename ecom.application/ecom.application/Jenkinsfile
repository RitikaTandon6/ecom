pipeline
{
  agent { label 'java-maven'}
  stages
  {
    stage('Checkout')
    {
      steps
      {
        checkout scm
      }
    }
    stage('Build')
    {
      steps {
        bat 'mvn clean package -DskipsTests ecom.application/ecom.application/pom.xml'
      }
    }
     stage('Archive JAR') {
            steps {
                archiveArtifacts artifacts: 'ecom.application/ecom.application/target/*.jar', 
                                 fingerprint: true
            }
        }
    
  }
  post
  {
    success{ echo 'Build succesfull' }
    
      failure{ echo 'Build failed' }      
}
}
